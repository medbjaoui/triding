# Copiez ce fichier en ".env" puis remplissez vos clés.
# NE PARTAGEZ JAMAIS ce fichier une fois rempli. Ne le versionnez pas (git).

# Clés API Binance — créées avec "Enable Spot Trading" UNIQUEMENT.
# JAMAIS "Enable Withdrawals" (retraits) !
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Paire et unité de temps
PAIR=BTC/USDT
TIMEFRAME=1h

# true = simulation (aucun ordre réel) ; false = trading réel
DRY_RUN=true

# Fréquence de vérification (minutes)
CHECK_INTERVAL_MIN=15

# Paramètres de stratégie
EMA_FAST=20
EMA_SLOW=50
RSI_PERIOD=14
RSI_MAX_BUY=70
STOP_LOSS_PCT=3.0
TAKE_PROFIT_PCT=5.0
CAPITAL_FRACTION=0.98

# Coupe-circuit : arrêt définitif si le capital perd ce % du départ
MAX_LOSS_PCT=25.0
